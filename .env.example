# Postgres (docker compose)
POSTGRES_USER=medic
POSTGRES_PASSWORD=change-me
POSTGRES_DB=medic

# App, when running outside docker against the compose database
DATABASE_URL=postgresql+psycopg://medic:change-me@localhost:5432/medic
RESERVATION_TTL_MINUTES=10

# Production only (Caddy, `--profile prod`)
DOMAIN=example.com
